{
  "name": "music-theory-tutor-core",
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "clean": "node -e \"import('node:fs/promises').then(({rm})=>Promise.all([rm('dist',{recursive:true,force:true}),rm('site',{recursive:true,force:true})]))\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "build:site": "npm run build && node scripts/build-site.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
